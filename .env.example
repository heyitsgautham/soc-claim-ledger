# Every variable the code reads, with its default.
# Every one is optional, and an empty value means the default, so this file runs the demo as committed.
# To change a setting, copy this file to apps/web/.env.local and fill in the line.
# The web app, the recording scripts and pnpm check:names read apps/web/.env.local.
# The API reads its two settings from the shell environment only.
# scripts/env-example.test.ts fails when the code reads a variable this file does not list.

# Web app (apps/web/src/lib/data.ts) and API (apps/api/ledger_api/paths.py).
# Where pnpm simulate writes the submissions and pnpm analyse writes derived/.
# Empty means data/demo at the repository root. Give an absolute path.
LEDGER_DATA_DIR=

# Web app (apps/web/src/lib/data.ts). Where examiner verdicts, the audit log and exported reports go.
# Empty means data/local at the repository root.
LEDGER_LOCAL_DIR=

# Web app (apps/web/src/lib/env.ts). The examiner ID stamped on verdicts and report exports.
LEDGER_EXAMINER=EX-02

# API only (apps/api/ledger_api/paths.py). The Parquet warehouse written by `python -m ledger_api ingest`.
# Empty means $LEDGER_DATA_DIR/parquet.
LEDGER_WAREHOUSE_DIR=

# End-to-end test only (apps/web/e2e/offline.test.ts). The running web app the offline test drives.
LEDGER_URL=http://localhost:3157

# Display names (apps/web/src/lib/brand.ts). Empty, the app shows "SOC Claim Ledger" and no event.
# pnpm check:names and the pre-commit hook fail if any value set here appears in a tracked file.
NEXT_PUBLIC_PRODUCT=
NEXT_PUBLIC_PS=
NEXT_PUBLIC_EVENT=
NEXT_PUBLIC_EVENT_NAME=
NEXT_PUBLIC_TAGLINE=

# pnpm check:names (scripts/private-names.ts). Extra terms refused in tracked files, separated by "|".
PRIVATE_TERMS=

# Recording only (recording/brand.ts). How the voiceover pronounces the product name.
PRODUCT_SAY=
