# Every setting is optional, and the defaults run the demo as committed.
# To change one, copy this file to apps/web/.env.local and uncomment the line.
# The web app, the recording scripts and pnpm check:names read apps/web/.env.local.
# The API reads its two settings from the shell environment only.

# Web app (apps/web/src/lib/data.ts) and API (apps/api/ledger_api/paths.py).
# Where pnpm simulate writes the submissions and pnpm analyse writes derived/.
# Defaults to data/demo at the repository root. Give an absolute path.
# LEDGER_DATA_DIR=/path/to/soc-claim-ledger/data/demo

# Web app. Where examiner verdicts, the audit log and exported reports go.
# Defaults to data/local at the repository root.
# LEDGER_LOCAL_DIR=/path/to/soc-claim-ledger/data/local

# Web app. The examiner ID stamped on verdicts and report exports.
# LEDGER_EXAMINER=EX-02

# API only. The Parquet warehouse written by `python -m ledger_api ingest`. Defaults to $LEDGER_DATA_DIR/parquet.
# LEDGER_WAREHOUSE_DIR=/path/to/soc-claim-ledger/data/demo/parquet

# End-to-end test only. The running web app the offline test drives.
# LEDGER_URL=http://localhost:3157

# Display names (apps/web/src/lib/brand.ts). Unset, the app shows "SOC Claim Ledger" and no event.
# pnpm check:names and the pre-commit hook fail if any value set here appears in a tracked file.
# NEXT_PUBLIC_PRODUCT=
# NEXT_PUBLIC_PS=
# NEXT_PUBLIC_EVENT=
# NEXT_PUBLIC_EVENT_NAME=
# NEXT_PUBLIC_TAGLINE=

# Extra terms pnpm check:names refuses in tracked files, separated by "|".
# PRIVATE_TERMS=

# Recording only (recording/brand.ts). How the voiceover pronounces the product name.
# PRODUCT_SAY=
